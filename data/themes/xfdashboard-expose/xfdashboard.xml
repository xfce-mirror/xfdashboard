<interface>
	<object class="XfdashboardStageInterface" id="primary">
		<child>
			<object class="XfdashboardActor">
				<property name="x-expand">true</property>
				<property name="y-expand">true</property>
				<property name="y">40</property>

				<constraint>
					<object class="ClutterBindConstraint">
						<property name="coordinate">width</property>
						<property name="offset">0</property>
						<property name="source" ref="primary"/>
					</object>
				</constraint>

				<constraint>
					<object class="ClutterBindConstraint">
						<property name="coordinate">height</property>
						<property name="offset">-40</property>
						<property name="source" ref="primary"/>
					</object>
				</constraint>

				<layout>
					<object class="ClutterBoxLayout">
						<property name="orientation">vertical</property>
						<property name="spacing">20.0</property>
						<property name="homogeneous">false</property>
					</object>
				</layout>

				<!-- Search box -->
				<child>
					<object class="XfdashboardActor" id="viewselector-searchbox-box">
						<property name="x-expand">false</property>
						<property name="min-width">500%</property>

						<layout>
							<object class="ClutterBoxLayout">
								<property name="orientation">horizontal</property>
								<property name="spacing">0.0</property>
							</object>
						</layout>

						<child>
							<object class="XfdashboardViewSelector" id="view-selector"> <!-- buttons left of searchbox -->
								<property name="viewpad" ref="viewpad"></property>
								<property name="spacing">0.0</property>
							</object>
						</child>

						<child>
							<object class="XfdashboardTextBox" id="searchbox">
								<property name="can-focus">true</property>
								<property name="x-expand">true</property>
								<property name="editable">true</property>
							</object>
						</child>
					</object>
				</child>

				<!-- Viewpad -->
				<child>
					<object class="XfdashboardActor" id="viewpad-container">
						<property name="x-expand">true</property>
						<property name="y-expand">true</property>
						<property name="margin-left">10%</property>
						<property name="margin-right">10%</property>

						<layout>
							<object class="ClutterBoxLayout">
								<property name="orientation">horizontal</property>
							</object>
						</layout>

						<child>
							<object class="XfdashboardViewpad" id="viewpad">
								<property name="can-focus">false</property>
								<property name="x-expand">true</property>
								<property name="y-expand">true</property>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</object>

	<focusables>
		<focus ref="searchbox" />
		<focus ref="viewpad" />
	</focusables>
</interface>
